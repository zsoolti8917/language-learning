# Server (apps/api). See docs/contracts.md, "Environment and run modes".
APP_ENV=local                 # local | preview | production
DB_MODE=pglite                # postgres | pglite
DATABASE_URL=                 # Supabase transaction pooler, port 6543 (DB_MODE=postgres)
AUTH_MODE=dev                 # supabase | dev
SUPABASE_URL=                 # token issuer and JWKS host (AUTH_MODE=supabase)
SUPABASE_SECRET_KEY=          # only for deleting a login on account deletion
AI_MODE=mock                  # anthropic | mock
ANTHROPIC_API_KEY=            # only when AI_MODE=anthropic
# AI_MODEL_TUTOR_REPLY=claude-opus-5-5   # optional per route override, AI_MODEL_<ROUTE>
AI_DAILY_BUDGET_USD=1.00

# Client (apps/web)
VITE_API_BASE=/api/v1
VITE_AUTH_MODE=dev            # supabase | dev
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MOCK_API=false           # true starts the mock server in the browser

# API local extras (F5)
# PGLITE_DIR=.local/pgdata    # PGlite data folder (DB_MODE=pglite)
# PORT=8787                   # local server port
# CONTENT_DIR=                # content folder loaded in local mode (default: mini dataset)
# VALIDATE_RESPONSES=false    # validate responses against contracts (on in tests and local mode)
